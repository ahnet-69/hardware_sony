# XperiaDisplay
binder_call(system_app, vendor_hal_disp_default)
allow system_app vendor_hal_disp_hwservice:hwservice_manager find;

# Extlight
allow system_app vendor_hal_light_service:service_manager find;
binder_call(system_app, vendor_hal_light_default)

# Framerate controller
binder_call(system_app, vendor_hal_disp_framerate_hwservice)
allow system_app vendor_hal_disp_framerate_hwservice:hwservice_manager find;

# Kcal
allow system_app sysfs_kcal:dir search;
allow system_app sysfs_kcal:file rw_file_perms;
