<resources>
    <!-- App Name -->
    <string name="app_name" translatable="true">Xperia 音频</string>

    <!-- Audio Settings -->
    <string name="audio_menu_title">音频设置</string>
    <string name="audio_menu_header">音质</string>
    <string name="audio_setting_summary">通过 Dolby Sound EQ 提升音质，带来非凡的沉浸式音频播放体验</string>

    <string name="dsee_title">DSEE Ultimate</string>
    <string name="dsee_summary">使用AI技术精准提升压缩音乐音质</string>
    <string name="windnr_title">智能风噪过滤</string>
    <string name="windnr_summary">录制时消除麦克风风噪\n采用声音分离技术，可在无音质损失下降噪（仅限内置麦克风）</string>

    <string name="dolby_title">Dolby Sound</string>
    <string name="dolby_summary">调整杜比音效 (Dolby Sound) 设置，体验身临其境的多维声音，让电影、音乐和游戏栩栩如生</string>

    <string name="dtsx_title">DTS:X Ultra</string>
    <string name="dtsx_summary">DTS:X Ultra 通过三维空间效果和用户可调节的均衡器提高音频质量，为用户提供更具吸引力的娱乐环境</string>

    <string name="audio_menu_footer">在播放具有声音增强功能的音频内容时，内容的信息将优先于此屏幕上的设置。当关闭声音增强时，也可以正确播放高分辨率内容。</string>
</resources>
